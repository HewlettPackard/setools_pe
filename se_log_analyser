# =====================
# Regex Patterns
# =====================

# The following examples are not exhaustive
# parse logs
# type=PROCTITLE msg=audit(07/09/2024 16:38:22.104:7145) : proctitle=/bin/bash /usr/bin/myapp
# type=PATH msg=audit(07/09/2024 16:38:22.104:7145) : item=0 name=. inode=2228225 dev=08:02 mode=dir,700 ouid=root ogid=root rdev=00:00 obj=system_u:object_r:admin_home_t:s0 nametype=NORMAL cap_fp=none cap_fi=none cap_fe=0 cap_fver=0 cap_frootid=0
# type=CWD msg=audit(07/09/2024 16:38:22.104:7145) : cwd=/root
# type=SYSCALL msg=audit(07/09/2024 16:38:22.104:7145) : arch=x86_64 syscall=stat success=yes exit=0 a0=0x55db166d1f7e a1=0x7ffea7e95440 a2=0x7ffea7e95440 a3=0x73 items=1 ppid=4732 pid=5041 auid=root uid=root gid=root euid=root suid=root fsuid=root egid=root sgid=root fsgid=root tty=pts1 ses=29 comm=myapp exe=/usr/bin/bash subj=unconfined_u:system_r:myapp_t:s0-s0:c0.c1023 key=(null)
REGEX_FULL_AVC = re.compile(r"type=PROCTITLE(?:.*)proctitle=(.*?)(?: \\n|\\n| \n|\n|type=)+(?:(?:.|\n)*)?SYSCALL (.*?)(?: \\n|\\n| \n|\n|type=)")
# type=SYSCALL msg=audit(07/09/2024 16:38:22.104:7145) : arch=x86_64 syscall=stat success=yes exit=0 a0=0x55db166d1f7e a1=0x7ffea7e95440 a2=0x7ffea7e95440 a3=0x73 items=1 ppid=4732 pid=5041 auid=root uid=root gid=root euid=root suid=root fsuid=root egid=root sgid=root fsgid=root tty=pts1 ses=29 comm=myapp exe=/usr/bin/bash subj=unconfined_u:system_r:myapp_t:s0-s0:c0.c1023 key=(null)
REGEX_SYSCALL_AVC = re.compile(r"SYSCALL (.*?)(?: \\n|\\n| \n|\n|type=)")
# type=PROCTITLE msg=audit(07/09/2024 16:38:22.104:7145) : proctitle=/bin/bash /usr/bin/myapp
REGEX_EXTRACT_PROCTITLE = re.compile(r" proctitle=(.*?)(?: \n|\n| \\n|\\n|type=)")
# ppid=4732 pid=5041
REGEX_EXTRACT_PID_PPID = re.compile(r"\bppid=(\d+)\b.*?\bpid=(\d+)\b")
# uid=root
REGEX_EXTRACT_UID = re.compile(r" uid=(\S+)")
# ppid=4732
REGEX_EXTRACT_PPID = re.compile(r" ppid=([0-9]+)")
REGEX_EXTRACT_FOR_PID = re.compile(r"for  pid=([0-9]+)")
REGEX_EXTRACT_PID = re.compile(r" pid=([0-9]+)")
# cmdline="bash compile"
# OR cmdline=bash
REGEX_EXTRACT_CMDLINE = re.compile(r' cmdline=("(?:.+?)"|\S+)')
REGEX_EXTRACT_EXE = re.compile(r' exe=("(?:.+?)"|\S+)')
REGEX_EXTRACT_COM = re.compile(r" comm=(\S+)")
# subj=unconfined_u:system_r:myapp_t:s0-s0:c0.c1023
REGEX_EXTRACT_SUBJ = re.compile(r" subj=(\S+)")
# msg=audit(07/09/2024 16:38:22.104:7145) OR msg=audit(1720536502.104:7145)
REGEX_EXTRACT_MSG_AUDIT = re.compile(r"msg=audit\(([^)]+)\)")
# argc=3 a0="/bin/bash" a1="-c" a2="echo hello"
REGEX_EXTRACT_EXECVE_ARG = re.compile(r' a(\d+)=("[^"]*"|\S+)')
# type=AVC
# OR: type=USER_AVC
REGEX_AVC_DELIMITER = re.compile(r"type=(?:USER_)?AVC")
# scontext=unconfined_u:system_r:myapp_t:s0-s0:c0.c1023 tcontext=system_u:object_r:admin_home_t:s0 tclass=dir
REGEX_EXTRACT_CONTEXT = re.compile(r"\{(.*)\}(?:.*)scontext=(\S+)(?:.*)tcontext=(\S+)(?:.*)tclass=(\S+)(?:.*)")
#parse files
# MYAPP_0001
REGEX_INDEX_TEMPLATE = re.compile(r"\S+_[0-9]{4}")
# pid=21017@Rocky                   ctx: system_u:system_r:myapp_t:s0-s0:c0.c1023                 cmd: sleep 1
# pid=23944@Rocky [APP ROOT]        ctx: system_u:system_r:myapp_t:s0-s0:c0.c1023                 cmd: ls -Z /usr/bin/myapp
REGEX_PID_TREE_ENTRY = re.compile(r"pid=(\d+)@(\S+)(?:\s+\[APP ROOT\])?\s+ctx:\s*(\S+)\s+cmd:\s*(.*)")
# # Process Tree (APP Root detected at 23944)
# # Process Tree (APP Roots detected at 23906, 24534, 27359, 27525)
# OR: # APP Process Tree (root: 23944)
REGEX_PID_TREE_HEADER = re.compile(r"^# (?:\S+ )?Process Tree|^# Orphan")
# Detect the APP root PID(s) from header: (APP Root(s) detected at 23944) or (root: 23944)
# Captures the full comma-separated list of PIDs
REGEX_PID_TREE_ROOT = re.compile(r"(?:APP Roots? detected at|root:)\s+([\d,\s]+)")
# pid=23944@Rocky  ->  extract the key part after @
REGEX_PID_TREE_KEY = re.compile(r"pid=\d+@(\S+)")
# myapp_t myapp_t:file open;
REGEX_ALLOW_RULE = re.compile(r"(\S+) (\S+):(\S+) (\S+);")
#     Debian_docker_v1 | RUNC_0001 (pid=3988 ; pid_ns=4026532289)
REGEX_MAIN_EXPLANATION = re.compile(rf"(\S+) {re.escape(KEY_DELIMITER)} (.*) \(pid=([0-9]*) ; pid_ns=(\S+)\)")


# =====================
# Module-level Utility Functions
# =====================

def get_base_cmd(cmd):
    """return the script or bin name of the cmd"""
    if isinstance(cmd, str):
        cmd = cmd.split()
    if not cmd:
        return UNKNOWN
    base = os.path.basename(cmd[0])
    i = 1
    n = len(cmd)
    while base in emulators and i < n:
        base = os.path.basename(cmd[i])
        i += 1
    if base.startswith("-") and i - 2 >= 0:
        # take the base before the first argument
        base = os.path.basename(cmd[i - 2])
    return base.upper()


def pgrep(cmd):
    """Return a list of process IDs matching the given name."""
    pids = []
    for proc in psutil.process_iter(["pid", "cmdline"]):
        cmdline = proc.info.get("cmdline")
        if cmdline and cmd in " ".join(cmdline):
            pids.append(proc.info["pid"])
    return pids


def get_entry_id(block):
    """Extract a unique identifier from an audit log block (msg=audit timestamp:serial)"""
    match = REGEX_EXTRACT_MSG_AUDIT.search(block)
    if match:
        return match.group(1)
    # Fallback: hash the block content
    return hashlib.sha256(block.encode()).hexdigest()


def extract_execve_command(block):
    """Extract the full command line from an EXECVE audit block"""
    # Find the EXECVE line(s) specifically - don't extract from SYSCALL line
    # which has memory addresses like a0=0xc000458ca0
    execve_lines = []
    for line in block.split('\n'):
        if 'type=EXECVE' in line or (line.strip().startswith('a') and '=' in line and 'argc=' in block):
            # Check if this line contains actual command args (not hex addresses)
            if 'a0=' in line and not line.split('a0=')[1].startswith('0x'):
                execve_lines.append(line)

    # If no EXECVE-specific lines found, try to find the EXECVE section
    if not execve_lines:
        for line in block.split('\n'):
            if 'type=EXECVE' in line:
                execve_lines.append(line)

    if not execve_lines:
        return None

    execve_text = ' '.join(execve_lines)

    args = {}
    for match in REGEX_EXTRACT_EXECVE_ARG.finditer(execve_text):
        arg_val = match.group(2).strip('"')
        # Skip if it looks like a memory address
        if arg_val.startswith('0x'):
            continue
        arg_num = int(match.group(1))
        args[arg_num] = arg_val

    if not args:
        return None

    # Reconstruct command from ordered arguments
    cmd_parts = []
    for i in range(max(args.keys()) + 1):
        if i in args:
            cmd_parts.append(args[i])

    return " ".join(cmd_parts) if cmd_parts else None


